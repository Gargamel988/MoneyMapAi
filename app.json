{
  "expo": {
    "name": "MoneyMapAi",
    "slug": "my-ai-app",
    "version": "1.0.4",
    "owner": "gargamel123",
    "orientation": "portrait",
    "icon": "./assets/ic_launcher_foreground.png",
    "scheme": "moneymapai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/ic_launcher_foreground.png",
        "monochromeImage": "./assets/ic_launcher_foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.omeraydin.moneymapai"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://gargamel123-my-ai-app.expo.app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-screen.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://gargamel123-my-ai-app.expo.app"
      },
      "eas": {
        "projectId": "c0d60501-09ba-4028-b8d8-6a698c04c6fa"
      }
    }
  }
}
