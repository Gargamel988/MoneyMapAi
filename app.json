{
  "expo": {
    "name": "MoneyMapAi",
    "slug": "my-ai-app",
    "version": "1.0.9",
    "owner": "gargamel9288",
    "orientation": "portrait",
    "icon": "./assets/ic_launcher_foreground.png",
    "scheme": "moneymapai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 18,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/ic_launcher_foreground.png",
        "monochromeImage": "./assets/ic_launcher_foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.omeraydin.moneymapai"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://gargamel123-my-ai-app.expo.app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-screen.jpg",
          "resizeMode": "cover",
          "backgroundColor": "#4A7FA7",
          "dark": {
            "backgroundColor": "#1A3D63"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://gargamel123-my-ai-app.expo.app"
      },
      "eas": {
        "projectId": "b27596fd-e322-4e34-881f-1deee5e441af"
      }
    }
  }
}
