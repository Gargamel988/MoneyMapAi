{
  "expo": {
    "name": "MoneyMapAi",
    "slug": "my-ai-app",
    "version": "1.0.11",
    "owner": "gargamel9288",
    "orientation": "portrait",
    "icon": "./assets/logo-new.png",
    "scheme": "moneymapai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 29,
      "adaptiveIcon": {
        "backgroundColor": "#1A3D63",
        "foregroundImage": "./assets/logo-new.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.omeraydin.moneymapai"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/logo-new.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://my-ai-app-0cc81e.expo.app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-new.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A3D63",
          "dark": {
            "backgroundColor": "#0B272A"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class com.google.android.gms.internal.consent_sdk.** { *; }"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://my-ai-app-0cc81e.expo.app"
      },
      "eas": {
        "projectId": "b27596fd-e322-4e34-881f-1deee5e441af"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b27596fd-e322-4e34-881f-1deee5e441af"
    }
  }
}
